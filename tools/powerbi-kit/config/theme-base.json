{
  "name": "Comète BI v0.9.14",
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.157.json",
  "dataColors": [
    "#429AEF",
    "#F8BF01",
    "#1F92BB",
    "#DA62AC",
    "#82B536",
    "#8270DB",
    "#FCA013",
    "#58759F"
  ],
  "foreground": "#3B3D42",
  "background": "#FFFFFF",
  "tableAccent": "#2467D1",
  "good": "#009B60",
  "neutral": "#E19800",
  "bad": "#E12121",
  "maximum": "#1E3661",
  "center": "#66B8F4",
  "minimum": "#C1E3FC",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 20,
      "color": "#1E3661"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#1E3661"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#3B3D42"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#505258"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D8DEDF"
              }
            },
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1E3661"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 13,
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "alignment": "left"
          }
        ],
        "visualTooltip": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "titleFontColor": {
              "solid": {
                "color": "#6F8488"
              }
            },
            "valueFontColor": {
              "solid": {
                "color": "#252A2C"
              }
            },
            "actionFontColor": {
              "solid": {
                "color": "#224986"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F6F6F6"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F0F1F2"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1E3661"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 20
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#505258"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "dataLabels": [
          {
            "color": {
              "solid": {
                "color": "#1E3661"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1E3661"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#3B3D42"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F6F6F6"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
