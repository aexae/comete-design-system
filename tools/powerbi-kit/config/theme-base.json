{
  "name": "Comète BI v0.5",
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.157.json",
  "dataColors": [
    "#2467D1",
    "#E19800",
    "#009B60",
    "#F44040",
    "#2354AA",
    "#BB6C02",
    "#66B8F4",
    "#BE1717"
  ],
  "foreground": "#3B3D42",
  "background": "#FFFFFF",
  "tableAccent": "#2467D1",
  "good": "#009B60",
  "neutral": "#E19800",
  "bad": "#E12121",
  "maximum": "#1E3661",
  "center": "#66B8F4",
  "minimum": "#C1E3FC",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#1E3661"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#1E3661"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#3B3D42"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#505258"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DDDEE1"
              }
            },
            "radius": 4
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1E3661"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 13,
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "alignment": "left"
          }
        ],
        "visualTooltip": [
          {
            "titleFontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "valueFontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "background": {
              "solid": {
                "color": "#1E3661"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F6F6F6"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F0F1F2"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1E3661"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 24
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#505258"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "dataLabels": [
          {
            "color": {
              "solid": {
                "color": "#1E3661"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1E3661"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#3B3D42"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F6F6F6"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#F0F1F2"
              }
            }
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#1E3661"
              }
            },
            "backColor": {
              "solid": {
                "color": "#DCEEFD"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1E3661"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#3B3D42"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#3B3D42"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F6F6F6"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#F0F1F2"
              }
            }
          }
        ],
        "subTotals": [
          {
            "fontColor": {
              "solid": {
                "color": "#1E3661"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1E3661"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#3B3D42"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "showMarker": false
          }
        ]
      }
    },
    "kpi": {
      "*": {
        "indicator": [
          {
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "goals": [
          {
            "goodColor": {
              "solid": {
                "color": "#009B60"
              }
            },
            "badColor": {
              "solid": {
                "color": "#E12121"
              }
            }
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "calloutValues": [
          {
            "color": {
              "solid": {
                "color": "#1E3661"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 24
          }
        ],
        "calloutLabels": [
          {
            "color": {
              "solid": {
                "color": "#505258"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#EAEDEE"
              }
            },
            "transparency": 0
          }
        ],
        "outline": [
          {
            "show": false
          }
        ],
        "text": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#252A2C"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "shape": [
          {
            "rectangleRoundedCurve": 6
          }
        ],
        "icon": [
          {
            "iconSize": 24
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "text": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#252A2C"
              }
            }
          }
        ],
        "background": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "outline": [
          {
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#D8DEDF"
              }
            },
            "weight": 1
          }
        ],
        "shape": [
          {
            "rectangleRoundedCurve": 4
          }
        ]
      }
    }
  }
}