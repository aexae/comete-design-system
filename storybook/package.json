{
  "name": "@aexae/comete-design-system-storybook",
  "version": "0.0.2-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "preview": "serve storybook-static -s -p 6006",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write . --ignore-path ../.prettierignore --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore --ignore-path .gitignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "chromatic": "chromatic"
  },
  "dependencies": {
    "@aexae/comete-design-system": "file:..",
    "@aexae/comete-logos": "0.15.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@aexae/comete-design-tokens": "0.41.0",
    "@aexae/comete-icons": "0.14.0",
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@mdx-js/react": "^3.1.1",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-designs": "^12.0.0",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-mcp": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@types/node": "^26.6.6",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "chromatic": "^18.15.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.8",
    "globals": "^17.14.0",
    "playwright": "1.65.1",
    "serve": "^14.2.8",
    "storybook": "^10.6.8",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
